rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    match /profilePhotos/{userId}/{allPaths=**} {
      // Avatars appear next to public catches and chat messages where the
      // viewer may not even know the photo owner. Same anonymous-fetch issue
      // as publicCatchPhotos — make them publicly readable.
      allow read;
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && underLimit();
    }

    match /publicCatchPhotos/{userId}/{allPaths=**} {
      // Public by definition — these photos render in the global feed and
      // were uploaded via raw HTTPS POST (which doesn't generate the magic
      // `firebaseStorageDownloadTokens` metadata that signed download URLs
      // need to bypass rules). Allow anonymous read so `expo-image` (and any
      // other fetcher without a Firebase auth header) can load them.
      // Trade-off: someone could scrape the bucket by URL, but every photo
      // here is intended to be publicly visible in the feed anyway.
      allow read;
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && underLimit();
    }

    match /damFeeds/{damId}/{userId}/{fileName} {
      // Same reasoning — dam-feed photos appear publicly in the dam screen.
      allow read;
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && underLimit();
    }

    match /stories/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'))
        && request.resource.size < 100 * 1024 * 1024; // 100 MB for videos
    }

    match /chatMedia/{convId}/{fileName} {
      // convId is always sorted(uid1, uid2).join('_') — sender must be one of the two participants
      allow read: if signedIn()
        && (convId.split('_')[0] == request.auth.uid
          || convId.split('_')[1] == request.auth.uid);
      // Image-only. Without isImage() the 50 MB cap accepted arbitrary binaries.
      // 10 MB cap matches the rest of the app and the client-side guard in ChatDetailScreen.
      allow write: if signedIn()
        && (convId.split('_')[0] == request.auth.uid
          || convId.split('_')[1] == request.auth.uid)
        && isImage()
        && underLimit();
    }
  }
}
