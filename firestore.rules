rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** URL-scheme guard for media fields on public docs. We want to block
        javascript:, data:, file:, content://, etc. — anything that, when
        rendered as an <Image> source, could either execute or leak local
        device paths. Allowing https:// only also prevents accidental http
        mixed-content warnings. Empty strings pass (callers should pair this
        with a separate "field is string" check). */
    function isHttpsUrl(v) {
      return v is string && (v.size() == 0 || v.matches('https://.*'));
    }

    /** Returns the other participant's uid for a conversation. Relies on
        participantIds being a 2-element array (enforced on conversation create). */
    function peerUidForConv(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds[0] == request.auth.uid
        ? get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds[1]
        : get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds[0];
    }

    /** True when the caller has NOT been blocked by the other participant.
        Costs +1 read per write op (the exists() lookup) — the price of
        moderation. Used by message create, reaction create/update, and the
        conv-level update that bumps lastMessage. */
    function peerHasNotBlockedMeInConv(convId) {
      return !exists(/databases/$(database)/documents/users/$(peerUidForConv(convId))/blockedUsers/$(request.auth.uid));
    }

    /** Same check as peerHasNotBlockedMeInConv but for conversation create —
        the conv doc doesn't exist yet so participantIds is read from the
        incoming write. */
    function peerHasNotBlockedMeInRequest() {
      return !exists(
        /databases/$(database)/documents/users/$(
          request.resource.data.participantIds[0] == request.auth.uid
            ? request.resource.data.participantIds[1]
            : request.resource.data.participantIds[0]
        )/blockedUsers/$(request.auth.uid)
      );
    }

    /** Профил и лични подколекции — само собственикът пише. */
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId) && request.resource.data.uid == userId;
      allow delete: if isSelf(userId);

      match /catches/{catchId} {
        allow read, write: if isSelf(userId);
      }
      match /spots/{spotId} {
        allow read, write: if isSelf(userId);
      }
      /** Всеки логнат вижда следванията (взаимно следване, чат, брой последователи). */
      match /following/{targetUid} {
        allow read: if signedIn();
        allow write: if isSelf(userId);
      }
      /** Огледало на following — за броене на последователи без collectionGroup. */
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == followerUid;
      }
      match /joinedTournaments/{tid} {
        allow read, write: if isSelf(userId);
      }

      /** Mirror of the user's club memberships. Lets `fetchMyGroups` read directly
          without needing a collectionGroup index. Written only by the owner; created
          atomically alongside the matching members/{uid} doc inside each group. */
      match /groupMemberships/{groupId} {
        allow read: if isSelf(userId);
        allow write: if isSelf(userId);
      }

      /** Запазени публикации от лентата (отметка). */
      match /savedCatches/{catchId} {
        allow read, write: if isSelf(userId);
      }

      /** Хаштагове, които потребителят следва — лични, никой друг не ги вижда. */
      match /followedHashtags/{tag} {
        allow read, write: if isSelf(userId);
      }

      /** Заглушени разговори — лични, четат се само от собственика. */
      match /mutedConversations/{convId} {
        allow read, write: if isSelf(userId);
      }

      /** Online presence + lastSeen. Pulled out of the heavy parent user doc
          so subscribers don't re-fire on photo/displayName/unread changes.
          Read by any signed-in user; only the owner can write. */
      match /presence/{document} {
        allow read: if signedIn();
        allow write: if isSelf(userId);
      }

      /** Блокирани потребители — само собственикът чете/пише. */
      match /blockedUsers/{targetUid} {
        allow read, write: if isSelf(userId);
      }

      /** Заглушени актьори — собственикът контролира кои потребители
          могат да го известяват с push. Cloud Function чете това при
          fan-out; никой друг няма достъп. */
      match /mutedActors/{actorUid} {
        allow read, write: if isSelf(userId);
      }

      /** Private user data (push token, etc.) — only the owner can read or write. */
      match /private/{document} {
        allow read, write: if isSelf(userId);
      }

      /** Notification preferences and other user settings. */
      match /settings/{document} {
        allow read, write: if isSelf(userId);
      }

      /** Известия за харесвания и коментари по мои публични улови. */
      match /notifications/{nid} {
        allow read, delete: if isSelf(userId);
        // Actor writes a notification (create or self-update). Update covers
        // the re-follow case (deterministic-id setDoc becomes an UPDATE
        // because the original doc still exists from the first follow); the
        // additional `actorUid == resource.data.actorUid` guard on the
        // update path prevents actor B from overwriting actor A's slot
        // (notification IDs are predictable, so without this guard B could
        // setDoc on `like_alice_catch1` and make the slot read "B liked
        // your catch" — silly but possible).
        // Reshare and personalBest types added for the push improvements.
        allow create: if signedIn()
          && request.auth.uid != userId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 120
          && request.resource.data.type in ['like', 'comment', 'follow', 'storyLike', 'storyComment', 'mention', 'reshare', 'personalBest']
          && request.resource.data.preview is string
          && request.resource.data.preview.size() <= 200
          && request.resource.data.read == false
          && (
            (request.resource.data.type == 'follow'
              && (!('catchId' in request.resource.data) || request.resource.data.catchId == '')
              && request.resource.data.preview == '')
            || (request.resource.data.type in ['like', 'comment']
              && (
                (request.resource.data.catchId is string
                  && request.resource.data.catchId.size() > 0
                  && request.resource.data.catchId.size() <= 128)
                || (request.resource.data.get('postId', '') is string
                  && request.resource.data.get('postId', '').size() > 0
                  && request.resource.data.get('postId', '').size() <= 128)
              ))
            || (request.resource.data.type in ['storyLike', 'storyComment']
              && request.resource.data.storyId is string
              && request.resource.data.storyId.size() > 0
              && request.resource.data.storyId.size() <= 128)
            || (request.resource.data.type == 'mention'
              && request.resource.data.catchId is string
              && request.resource.data.catchId.size() > 0
              && request.resource.data.catchId.size() <= 128)
            || (request.resource.data.type == 'reshare'
              && request.resource.data.get('postId', '') is string
              && request.resource.data.get('postId', '').size() > 0
              && request.resource.data.get('postId', '').size() <= 128)
            || (request.resource.data.type == 'personalBest'
              && request.resource.data.catchId is string
              && request.resource.data.catchId.size() > 0
              && request.resource.data.catchId.size() <= 128)
          );
        // Actor self-update — same conditions as create plus the actorUid-
        // preservation guard. Covers the re-follow case: alice follows bob,
        // unfollows, follows again — the deterministic-id setDoc lands as
        // an UPDATE on the still-existing notification doc; both writes
        // are by alice, so actorUid is preserved.
        allow update: if signedIn()
          && request.auth.uid != userId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorUid == resource.data.actorUid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 120
          && request.resource.data.type in ['like', 'comment', 'follow', 'storyLike', 'storyComment', 'mention', 'reshare', 'personalBest']
          && request.resource.data.preview is string
          && request.resource.data.preview.size() <= 200
          && request.resource.data.read == false
          && (
            (request.resource.data.type == 'follow'
              && (!('catchId' in request.resource.data) || request.resource.data.catchId == '')
              && request.resource.data.preview == '')
            || (request.resource.data.type in ['like', 'comment']
              && (
                (request.resource.data.catchId is string
                  && request.resource.data.catchId.size() > 0
                  && request.resource.data.catchId.size() <= 128)
                || (request.resource.data.get('postId', '') is string
                  && request.resource.data.get('postId', '').size() > 0
                  && request.resource.data.get('postId', '').size() <= 128)
              ))
            || (request.resource.data.type in ['storyLike', 'storyComment']
              && request.resource.data.storyId is string
              && request.resource.data.storyId.size() > 0
              && request.resource.data.storyId.size() <= 128)
            || (request.resource.data.type == 'mention'
              && request.resource.data.catchId is string
              && request.resource.data.catchId.size() > 0
              && request.resource.data.catchId.size() <= 128)
            || (request.resource.data.type == 'reshare'
              && request.resource.data.get('postId', '') is string
              && request.resource.data.get('postId', '').size() > 0
              && request.resource.data.get('postId', '').size() <= 128)
            || (request.resource.data.type == 'personalBest'
              && request.resource.data.catchId is string
              && request.resource.data.catchId.size() > 0
              && request.resource.data.catchId.size() <= 128)
          );
        // Recipient can mark as read — separate from the actor write paths
        // above. Multiple allow rules OR together for update.
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    /** Публичен feed: четене за логнати; запис само собственикът на улова. */
    match /publicCatches/{catchId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (!('photoTitle' in request.resource.data)
          || (request.resource.data.photoTitle is string
            && request.resource.data.photoTitle.size() <= 120))
        && (!('speciesName' in request.resource.data)
          || (request.resource.data.speciesName is string
            && request.resource.data.speciesName.size() <= 120))
        && (!('notes' in request.resource.data)
          || (request.resource.data.notes is string
            && request.resource.data.notes.size() <= 2000))
        && (!('bait' in request.resource.data)
          || (request.resource.data.bait is string
            && request.resource.data.bait.size() <= 300))
        && (!('photoUri' in request.resource.data)
          || (request.resource.data.photoUri is string
            && request.resource.data.photoUri.size() <= 2000
            && isHttpsUrl(request.resource.data.photoUri)))
        && (!('ownerPhotoUrl' in request.resource.data)
          || (request.resource.data.ownerPhotoUrl is string
            && request.resource.data.ownerPhotoUrl.size() <= 1000
            && isHttpsUrl(request.resource.data.ownerPhotoUrl)))
        && (!('extraPhotoUris' in request.resource.data)
          || (request.resource.data.extraPhotoUris is list
            && request.resource.data.extraPhotoUris.size() <= 5))
        // Optional 15-second video clip. URL must be https:// for the
        // same reason as photoUri (no file:// or data: injections); 30000
        // ms is the hard ceiling on videoDurationMs — 15s + generous
        // rounding slop, but anything past that is rejected so a bad
        // client can't write 9999999 to fake an infinite progress bar.
        && (!('videoUri' in request.resource.data)
          || (request.resource.data.videoUri is string
            && request.resource.data.videoUri.size() <= 2000
            && isHttpsUrl(request.resource.data.videoUri)))
        && (!('videoDurationMs' in request.resource.data)
          || (request.resource.data.videoDurationMs is number
            && request.resource.data.videoDurationMs >= 0
            && request.resource.data.videoDurationMs <= 30000))
        // Poster JPEG generated client-side from the first frame. Same
        // https-only constraint as photoUri; size is the URL length, not
        // the image — the image itself is gated by R2's bucket limits.
        && (!('videoThumbnailUri' in request.resource.data)
          || (request.resource.data.videoThumbnailUri is string
            && request.resource.data.videoThumbnailUri.size() <= 2000
            && isHttpsUrl(request.resource.data.videoThumbnailUri)));
      // Update splits two paths so non-owners can still bump likeCount when
      // they react. The previous combined rule required ownerUid match for
      // ALL updates, which broke `toggleCatchReaction` for friends (rejected
      // with "Missing or insufficient permissions" the moment they tapped like).
      // Mirrors the pattern used for /posts and /groups.
      allow update: if signedIn() && (
        // Owner can change anything they could create.
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && (!('photoTitle' in request.resource.data)
            || (request.resource.data.photoTitle is string
              && request.resource.data.photoTitle.size() <= 120))
          && (!('speciesName' in request.resource.data)
            || (request.resource.data.speciesName is string
              && request.resource.data.speciesName.size() <= 120))
          && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
              && request.resource.data.notes.size() <= 2000))
          && (!('bait' in request.resource.data)
            || (request.resource.data.bait is string
              && request.resource.data.bait.size() <= 300))
          && (!('extraPhotoUris' in request.resource.data)
            || (request.resource.data.extraPhotoUris is list
              && request.resource.data.extraPhotoUris.size() <= 5))
          // Mirror the create-time video validation on owner updates so
          // editing a catch can attach or replace its clip with the same
          // constraints.
          && (!('videoUri' in request.resource.data)
            || (request.resource.data.videoUri is string
              && request.resource.data.videoUri.size() <= 2000
              && isHttpsUrl(request.resource.data.videoUri)))
          && (!('videoDurationMs' in request.resource.data)
            || (request.resource.data.videoDurationMs is number
              && request.resource.data.videoDurationMs >= 0
              && request.resource.data.videoDurationMs <= 30000))
          && (!('videoThumbnailUri' in request.resource.data)
            || (request.resource.data.videoThumbnailUri is string
              && request.resource.data.videoThumbnailUri.size() <= 2000
              && isHttpsUrl(request.resource.data.videoThumbnailUri))))
        ||
        // Any signed-in user can step likeCount by exactly ±1 (one reaction
        // toggle = one count change) and adjust the per-type reactionCounts
        // tally that backs the inline feed breakdown.
        //
        // - likeCount stays within ±1 of the prior value
        // - non-owner writes are limited via affectedKeys.hasOnly() so the
        //   reaction path can't be abused to clobber other fields (previously
        //   the rule never checked which keys were affected, so a non-owner
        //   could in theory rewrite the whole doc while still satisfying the
        //   likeCount ±1 constraint)
        // - reactionCounts is a free-form map and changes by ±1 per type
        //   inside the toggleCatchReaction transaction; we don't validate
        //   each per-type delta here because a misbehaving client could
        //   only inflate counts on its own writes (the corresponding likes
        //   subdoc is also written and gated by isSelf(uid))
        // - get('likeCount', 0) defaults legacy docs so the first like
        //   doesn't reject with permission-denied
        (request.resource.data.likeCount is number
          && request.resource.data.likeCount >= resource.data.get('likeCount', 0) - 1
          && request.resource.data.likeCount <= resource.data.get('likeCount', 0) + 1
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount', 'reactionCounts'])
          // Bound each per-type reaction tally to ±1 so a non-owner can't
          // inflate/corrupt the free-form reactionCounts map on someone else's
          // catch while satisfying the likeCount ±1 check. The client only ever
          // increments/decrements a single key per toggle (and two keys by ±1
          // on a reaction-switch), so per-key ±1 covers every legit write.
          // .get(...,{}) defaults a missing map so the first reaction doesn't reject.
          && request.resource.data.get('reactionCounts', {}).get('heart', 0) >= resource.data.get('reactionCounts', {}).get('heart', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('heart', 0) <= resource.data.get('reactionCounts', {}).get('heart', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('fire', 0) >= resource.data.get('reactionCounts', {}).get('fire', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('fire', 0) <= resource.data.get('reactionCounts', {}).get('fire', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('trophy', 0) >= resource.data.get('reactionCounts', {}).get('trophy', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('trophy', 0) <= resource.data.get('reactionCounts', {}).get('trophy', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('fish', 0) >= resource.data.get('reactionCounts', {}).get('fish', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('fish', 0) <= resource.data.get('reactionCounts', {}).get('fish', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('wow', 0) >= resource.data.get('reactionCounts', {}).get('wow', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('wow', 0) <= resource.data.get('reactionCounts', {}).get('wow', 0) + 1)
        ||
        // Comment-count bump — any signed-in user steps commentCount by ±1,
        // paired client-side with creating/deleting a comment doc (see
        // addCatchComment / deleteCatchComment). Kept as its own disjunct
        // (unlike /posts, which folds it into the like clause) so reaction
        // writes on legacy catches missing commentCount don't start failing
        // the `is number` check. affectedKeys.hasOnly prevents smuggling
        // other fields; get('commentCount', 0) defaults legacy docs.
        (request.resource.data.commentCount is number
          && request.resource.data.commentCount >= resource.data.get('commentCount', 0) - 1
          && request.resource.data.commentCount <= resource.data.get('commentCount', 0) + 1
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['commentCount']))
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        // Split into create/update + delete: on delete, request.resource is
        // null and `'reaction' in request.resource.data` errors → rules engine
        // denies the write. That broke the unlike flow's transaction (delete
        // like doc + decrement likeCount), which then rejected with
        // permission-denied for the whole batch.
        allow create, update: if isSelf(uid)
          && (!('reaction' in request.resource.data)
            || request.resource.data.reaction in ['heart','fire','trophy','fish','wow']);
        allow delete: if isSelf(uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        // Two update paths: the author can edit text/editedAt; any signed-in
        // user can bump likeCount via a comment-like toggle. Splitting the
        // rule lets non-authors react without needing edit permissions.
        allow update: if signedIn() && (
          (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000)
          ||
          // Counter bump — get('likeCount', 0) defaults legacy comments
          // (created before likeCount was a tracked field) so the rule
          // doesn't reject the first comment-like with permission-denied.
          // affectedKeys.hasOnly(['likeCount']) prevents the non-author bump
          // path from being abused to overwrite the comment's text or
          // replyTo fields while satisfying the ±1 constraint.
          (request.resource.data.likeCount is number
            && request.resource.data.likeCount >= resource.data.get('likeCount', 0) - 1
            && request.resource.data.likeCount <= resource.data.get('likeCount', 0) + 1
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']))
        );
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/publicCatches/$(catchId)).data.ownerUid == request.auth.uid
        );

        match /likes/{uid} {
          allow read: if signedIn();
          // Same split as the parent — delete needs its own clause because
          // `'reaction' in request.resource.data` errors when request.resource
          // is null (which it is for deletes), making the whole write reject.
          allow create, update: if isSelf(uid)
            && (!('reaction' in request.resource.data)
              || request.resource.data.reaction in ['heart','fire','trophy','fish','wow']);
          allow delete: if isSelf(uid);
        }
      }
    }

    /** Свободни публикации в лентата (без улов) — текст + опционална снимка + хаштагове / споменавания. */
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 120
        && (!('hashtags' in request.resource.data)
          || (request.resource.data.hashtags is list
            && request.resource.data.hashtags.size() <= 20))
        && (!('mentionUids' in request.resource.data)
          || (request.resource.data.mentionUids is list
            && request.resource.data.mentionUids.size() <= 20))
        && (!('photoUri' in request.resource.data)
          || (request.resource.data.photoUri is string
            && request.resource.data.photoUri.size() <= 1000
            && isHttpsUrl(request.resource.data.photoUri)))
        // Optional 15-second video clip + poster — same shape as
        // publicCatches/videoUri. 30000 ms ceiling = 15s + rounding slop.
        && (!('videoUri' in request.resource.data)
          || (request.resource.data.videoUri is string
            && request.resource.data.videoUri.size() <= 2000
            && isHttpsUrl(request.resource.data.videoUri)))
        && (!('videoThumbnailUri' in request.resource.data)
          || (request.resource.data.videoThumbnailUri is string
            && request.resource.data.videoThumbnailUri.size() <= 2000
            && isHttpsUrl(request.resource.data.videoThumbnailUri)))
        && (!('videoDurationMs' in request.resource.data)
          || (request.resource.data.videoDurationMs is number
            && request.resource.data.videoDurationMs >= 0
            && request.resource.data.videoDurationMs <= 30000))
        && (!('reshareOf' in request.resource.data)
          || (request.resource.data.reshareOf is map
            && request.resource.data.reshareOf.kind in ['catch', 'post']
            && request.resource.data.reshareOf.id is string
            && request.resource.data.reshareOf.id.size() <= 128
            && request.resource.data.reshareOf.ownerUid is string));
      allow update: if signedIn() && (
        // Owner can change anything they could create.
        resource.data.ownerUid == request.auth.uid
        ||
        // Counter bumps — likeCount/commentCount each by ±1, ownerUid
        // preserved, plus the per-reaction-type tally map that backs the
        // inline emoji breakdown in PostCard. Restricted via affectedKeys
        // so non-owners can't smuggle other fields in.
        // get('field', 0) defaults to 0 for legacy docs missing the field,
        // otherwise `resource.data.X - 1` errors and denies the write.
        // (Posts initialize both to 0 on create, but legacy posts and any
        // future create paths that miss it would otherwise fail.)
        (request.resource.data.likeCount is number
          && request.resource.data.likeCount >= resource.data.get('likeCount', 0) - 1
          && request.resource.data.likeCount <= resource.data.get('likeCount', 0) + 1
          && request.resource.data.commentCount is number
          && request.resource.data.commentCount >= resource.data.get('commentCount', 0) - 1
          && request.resource.data.commentCount <= resource.data.get('commentCount', 0) + 1
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount', 'commentCount', 'reactionCounts'])
          // Same per-type ±1 bound as publicCatches so the reactionCounts map
          // can't be inflated/corrupted on another user's post.
          && request.resource.data.get('reactionCounts', {}).get('heart', 0) >= resource.data.get('reactionCounts', {}).get('heart', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('heart', 0) <= resource.data.get('reactionCounts', {}).get('heart', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('fire', 0) >= resource.data.get('reactionCounts', {}).get('fire', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('fire', 0) <= resource.data.get('reactionCounts', {}).get('fire', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('trophy', 0) >= resource.data.get('reactionCounts', {}).get('trophy', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('trophy', 0) <= resource.data.get('reactionCounts', {}).get('trophy', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('fish', 0) >= resource.data.get('reactionCounts', {}).get('fish', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('fish', 0) <= resource.data.get('reactionCounts', {}).get('fish', 0) + 1
          && request.resource.data.get('reactionCounts', {}).get('wow', 0) >= resource.data.get('reactionCounts', {}).get('wow', 0) - 1
          && request.resource.data.get('reactionCounts', {}).get('wow', 0) <= resource.data.get('reactionCounts', {}).get('wow', 0) + 1)
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        // Validate the reaction enum the same way as /publicCatches likes so
        // that the multi-reaction picker can't be abused to write arbitrary
        // values. Missing-reaction (legacy heart-only) writes still pass.
        // delete is a separate clause — `'reaction' in request.resource.data`
        // errors when request.resource is null (deletes), which would block
        // the unlike-via-transaction flow with permission-denied.
        allow create, update: if isSelf(uid)
          && (!('reaction' in request.resource.data)
            || request.resource.data.reaction in ['heart','fire','trophy','fish','wow']);
        allow delete: if isSelf(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        // Mirrors the publicCatches/comments rule — author can edit text,
        // anyone can bump likeCount by ±1. affectedKeys.hasOnly(['likeCount'])
        // keeps the non-author bump path from being abused to overwrite text
        // or replyTo fields while satisfying the ±1 constraint.
        allow update: if signedIn() && (
          (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000)
          ||
          // Counter bump — defaults legacy comments without likeCount.
          (request.resource.data.likeCount is number
            && request.resource.data.likeCount >= resource.data.get('likeCount', 0) - 1
            && request.resource.data.likeCount <= resource.data.get('likeCount', 0) + 1
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']))
        );
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid == request.auth.uid
        );

        match /likes/{uid} {
          allow read: if signedIn();
          // Same delete-split as the parent post-likes / catch-likes rules.
          allow create, update: if isSelf(uid)
            && (!('reaction' in request.resource.data)
              || request.resource.data.reaction in ['heart','fire','trophy','fish','wow']);
          allow delete: if isSelf(uid);
        }
      }
    }

    /** Live "fishing here right now" pins — opt-in temporary location share, auto-expires. */
    match /liveFishingPins/{pinId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.expiresAt is number
        // expiresAt must be in the future but no more than ~5 hours ahead.
        // Client TTL is 4h; the extra 1h is buffer for clock skew.
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 5 * 60 * 60 * 1000
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 120
        && (!('note' in request.resource.data)
          || (request.resource.data.note is string
            && request.resource.data.note.size() <= 200))
        && (!('waterName' in request.resource.data)
          || (request.resource.data.waterName is string
            && request.resource.data.waterName.size() <= 120))
        && (!('ownerPhotoUrl' in request.resource.data)
          || (request.resource.data.ownerPhotoUrl is string
            && request.resource.data.ownerPhotoUrl.size() <= 1000
            && isHttpsUrl(request.resource.data.ownerPhotoUrl)));
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    /** Доклади за злоупотреба — без четене от клиенти; запис само от логнат потребител. */
    match /contentReports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['catch', 'comment']
        && request.resource.data.catchId is string
        && request.resource.data.catchId.size() >= 1
        && request.resource.data.catchId.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 500
        && (!('commentId' in request.resource.data)
          || (request.resource.data.commentId is string
            && request.resource.data.commentId.size() <= 128));
      allow update, delete: if false;
    }

    match /tournaments/{tid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.hostUid == request.auth.uid;

      match /participants/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid);
        allow delete: if signedIn() && (
          isSelf(uid)
          || get(/databases/$(database)/documents/tournaments/$(tid)).data.hostUid == request.auth.uid
        );
      }

      match /entries/{catchId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/tournaments/$(tid)).data.hostUid == request.auth.uid
        );
      }

      // Photo entries — keyed by ownerUid so each user gets one submission per
      // tournament. The /entries collection above is older / unused by the
      // current client (which calls submitCatchToTournament writing here).
      // Without this rule block, tournament submissions silently fail; the
      // app's leaderboard + rank-pin features stop working in production.
      match /photoEntries/{ownerUid} {
        allow read: if signedIn();
        // Owner can create/update their own entry. ownerUid in the payload
        // must match the doc id AND the writer.
        allow create, update: if isSelf(ownerUid)
          && request.resource.data.ownerUid == request.auth.uid
          && (!('photoUri' in request.resource.data)
            || (request.resource.data.photoUri is string
              && request.resource.data.photoUri.size() <= 2000
              && isHttpsUrl(request.resource.data.photoUri)))
          // Anyone bumping likeCount via reaction subcollection updates: see
          // the parent /tournaments update rule pattern — but here a
          // non-owner toggleTournamentEntryLike call needs to touch
          // `likeCount` on this entry, so split create/update from the
          // counter-only bump path. The like toggle code path is allowed
          // through the second branch below.
          ;
        // Counter bump — defaults legacy entries without likeCount.
        // affectedKeys.hasOnly(['likeCount']) keeps the non-owner counter-
        // bump path from being abused to overwrite photoUri / other fields
        // while satisfying the ±1 constraint. Same pattern as the publicCatches
        // and posts comment-like rules.
        allow update: if signedIn()
          && request.resource.data.likeCount is number
          && request.resource.data.likeCount >= resource.data.get('likeCount', 0) - 1
          && request.resource.data.likeCount <= resource.data.get('likeCount', 0) + 1
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']);
        allow delete: if signedIn() && (
          isSelf(ownerUid)
          || get(/databases/$(database)/documents/tournaments/$(tid)).data.hostUid == request.auth.uid
        );

        // Per-user like on a tournament entry. The doc id IS the liker's uid.
        match /likes/{likerUid} {
          allow read: if signedIn();
          allow write: if isSelf(likerUid);
        }
      }
    }

    /** Фийд със снимки по язовир — само логнати; запис само за свои публикации. */
    match /damFeeds/{damId}/feedPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.damId == damId
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 1000
        && isHttpsUrl(request.resource.data.photoUrl)
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() <= 500;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    /** Истории (24ч моменти) */
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 280))
        && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['photo', 'video'])
        && (!('mediaUrl' in request.resource.data) || (request.resource.data.mediaUrl is string && isHttpsUrl(request.resource.data.mediaUrl)));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;

      match /reactions/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid)
          && (!('reaction' in request.resource.data)
            || request.resource.data.reaction in ['heart','fire','trophy','fish','wow']);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid
        );
        allow update: if false;
      }
    }

    /** Рибарски рапорти за водоеми — всеки логнат може да пише/чете; само авторът изтрива. */
    match /waterReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.fishingActivity is number
        && request.resource.data.fishingActivity >= 1
        && request.resource.data.fishingActivity <= 5
        && request.resource.data.waterCondition in ['crystal','clear','murky','muddy']
        && (!('note' in request.resource.data)
          || (request.resource.data.note is string && request.resource.data.note.size() <= 200));
      allow delete: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow update: if false;
    }

    /** Клубове / групи */
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if signedIn() && (
        // Creator can change anything
        resource.data.createdBy == request.auth.uid
        ||
        // Any signed-in user can only touch memberCount / postCount (join, leave, post)
        // — and each only by ±1 per request so a troll can't set memberCount=0
        // on a 500-person group. Defaults via .get() so legacy docs that pre-date
        // these fields don't reject the first write.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'postCount'])
          && request.resource.data.get('memberCount', 0) is number
          && request.resource.data.get('memberCount', 0) >= resource.data.get('memberCount', 0) - 1
          && request.resource.data.get('memberCount', 0) <= resource.data.get('memberCount', 0) + 1
          && request.resource.data.get('postCount', 0) is number
          && request.resource.data.get('postCount', 0) >= resource.data.get('postCount', 0) - 1
          && request.resource.data.get('postCount', 0) <= resource.data.get('postCount', 0) + 1)
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid);
        allow delete: if isSelf(uid)
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
      }

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow delete: if signedIn() && (
          resource.data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );
        allow update: if false;
      }

      /** Събития в клуба — създава всеки член; чете всеки логнат; изтрива авторът или админът. */
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.dateIso is string
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow update: if signedIn() && (
          // Creator can edit fully
          resource.data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
          // Any signed-in member can bump RSVP counts — each known bucket
          // (going / maybe / not_going) bounded to ±1 per request so a
          // troll can't zero out attendance on a popular event. The .get()
          // default handles freshly-created events whose rsvpCounts map is
          // missing the bucket the user is voting in.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpCounts'])
            && request.resource.data.rsvpCounts is map
            && request.resource.data.rsvpCounts.get('going', 0) is number
            && request.resource.data.rsvpCounts.get('going', 0) >= resource.data.get('rsvpCounts', {}).get('going', 0) - 1
            && request.resource.data.rsvpCounts.get('going', 0) <= resource.data.get('rsvpCounts', {}).get('going', 0) + 1
            && request.resource.data.rsvpCounts.get('maybe', 0) is number
            && request.resource.data.rsvpCounts.get('maybe', 0) >= resource.data.get('rsvpCounts', {}).get('maybe', 0) - 1
            && request.resource.data.rsvpCounts.get('maybe', 0) <= resource.data.get('rsvpCounts', {}).get('maybe', 0) + 1
            && request.resource.data.rsvpCounts.get('not_going', 0) is number
            && request.resource.data.rsvpCounts.get('not_going', 0) >= resource.data.get('rsvpCounts', {}).get('not_going', 0) - 1
            && request.resource.data.rsvpCounts.get('not_going', 0) <= resource.data.get('rsvpCounts', {}).get('not_going', 0) + 1)
        );
        allow delete: if signedIn() && (
          resource.data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );

        match /rsvps/{uid} {
          allow read: if signedIn();
          allow write: if isSelf(uid)
            && (!('status' in request.resource.data)
              || request.resource.data.status in ['going','maybe','not_going']);
        }
      }

      /** Анкети в клуба — създава всеки член; гласува всеки логнат; изтрива авторът или админът. */
      match /polls/{pollId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.question.size() <= 280
          && request.resource.data.options is list
          && request.resource.data.options.size() >= 2
          && request.resource.data.options.size() <= 6
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow update: if signedIn() && (
          resource.data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
          // Any signed-in member can update voteCounts — each known bucket
          // (string-keyed "0".."5", matching the option indices) bounded to
          // ±1 per request so a troll can't zero out the leading option.
          // Defaults via .get() so missing keys (sparse map) don't reject.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCounts'])
            && request.resource.data.voteCounts is map
            && request.resource.data.voteCounts.get('0', 0) is number
            && request.resource.data.voteCounts.get('0', 0) >= resource.data.get('voteCounts', {}).get('0', 0) - 1
            && request.resource.data.voteCounts.get('0', 0) <= resource.data.get('voteCounts', {}).get('0', 0) + 1
            && request.resource.data.voteCounts.get('1', 0) is number
            && request.resource.data.voteCounts.get('1', 0) >= resource.data.get('voteCounts', {}).get('1', 0) - 1
            && request.resource.data.voteCounts.get('1', 0) <= resource.data.get('voteCounts', {}).get('1', 0) + 1
            && request.resource.data.voteCounts.get('2', 0) is number
            && request.resource.data.voteCounts.get('2', 0) >= resource.data.get('voteCounts', {}).get('2', 0) - 1
            && request.resource.data.voteCounts.get('2', 0) <= resource.data.get('voteCounts', {}).get('2', 0) + 1
            && request.resource.data.voteCounts.get('3', 0) is number
            && request.resource.data.voteCounts.get('3', 0) >= resource.data.get('voteCounts', {}).get('3', 0) - 1
            && request.resource.data.voteCounts.get('3', 0) <= resource.data.get('voteCounts', {}).get('3', 0) + 1
            && request.resource.data.voteCounts.get('4', 0) is number
            && request.resource.data.voteCounts.get('4', 0) >= resource.data.get('voteCounts', {}).get('4', 0) - 1
            && request.resource.data.voteCounts.get('4', 0) <= resource.data.get('voteCounts', {}).get('4', 0) + 1
            && request.resource.data.voteCounts.get('5', 0) is number
            && request.resource.data.voteCounts.get('5', 0) >= resource.data.get('voteCounts', {}).get('5', 0) - 1
            && request.resource.data.voteCounts.get('5', 0) <= resource.data.get('voteCounts', {}).get('5', 0) + 1)
        );
        allow delete: if signedIn() && (
          resource.data.createdBy == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );

        match /votes/{uid} {
          allow read: if signedIn();
          allow write: if isSelf(uid)
            && request.resource.data.optionIndex is number
            && request.resource.data.optionIndex >= 0
            && request.resource.data.optionIndex <= 5;
        }
      }
    }

    /** Pre-aggregated leaderboard — written only by Cloud Functions, read by all signed-in users. */
    match /leaderboardCache/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /** Per-user, per-bucket leaderboard rollup docs maintained by the
        `onPublicCatchForRollup` trigger + `weeklyLeaderboardDriftFix`.
        The client reads the pre-consolidated `leaderboardCache` instead,
        but `read` is allowed here so a future fallback path (direct
        rollup query when the cache doc is empty) can work without a
        rules change. All writes are server-side via admin SDK. */
    match /leaderboardRollup/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /** Per-callable rate-limit token buckets maintained by the
        `checkAndConsumeRateBucket` helper in functions/src/index.ts.
        Client-side reads would let an attacker probe their remaining
        budget (low risk but pointless to allow) and writes would let
        them reset their own bucket (bypass the limit entirely).
        Admin SDK in Cloud Functions bypasses these rules anyway. */
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    /** Pre-ranked weekly/monthly classics photos — written hourly by
        the `consolidateClassicsCache` Cloud Function, read by all
        signed-in users via fetchRankedClassicPhotos. Same shape rule
        as leaderboardCache. */
    match /classicsCache/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /** Директни съобщения — само двамата участници. */
    match /conversations/{convId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participantIds);
      // Conversation create: the other participant must not have blocked me,
      // otherwise a blocked user could re-open a fresh thread with the victim.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && peerHasNotBlockedMeInRequest();
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && (
          // (1) Participant-name updates only — the merge write in
          // ensureDirectConversation when a known conv is re-opened. Field-limited
          // to participantNames. The previous `participantIds == participantIds`
          // form was a CATCH-ALL: it passed for any update that left participantIds
          // untouched, so either participant could overwrite arbitrary fields —
          // including participantData (the notification cache the onNewMessage
          // Cloud Function trusts), unreadCounts, and lastMessage — bypassing the
          // block check in branch (2). Block check intentionally skipped here:
          // refreshing your own display name in shared state shouldn't fail just
          // because the peer has since blocked you.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantNames'])
          ||
          // (2) Message-metadata update that accompanies sendConversationMessage,
          // plus markConversationRead/markConversationUnread adjusting unread.
          // Only these fields allowed, and only if I haven't been blocked by the
          // peer — without the block check a blocked sender could still poison the
          // victim's inbox preview / unread badge even though their message create
          // is rejected separately.
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderUid', 'unreadCounts'])
           && peerHasNotBlockedMeInConv(convId))
          ||
          // (3) Mute mirror: a participant may write ONLY their own
          // participantData[uid] entry, and within it ONLY the `muted` sub-field
          // (muteConversation/unmuteConversation). The onNewMessage Cloud Function
          // reads participantData[recipient] for the recipient's prefs / mute /
          // push-token cache, so a participant must never be able to write the
          // OTHER participant's entry — nor inject extra fields into their own
          // entry. In particular a forged `pushToken` here would let the CF
          // deliver a peer's message to an attacker-chosen device, and forged
          // prefs could re-enable a notification the recipient disabled. The
          // prefs + pushToken cache is written EXCLUSIVELY by the CF (admin SDK,
          // which bypasses these rules); the client only ever flips `muted`, so
          // we pin the writable surface to exactly that.
          // `.get(uid, {})` defaults a missing own-entry so the first mute write
          // (before any CF backfill) still validates.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantData'])
           && (
             (!('participantData' in resource.data)
               && request.resource.data.participantData.keys().hasOnly([request.auth.uid])
               && request.resource.data.participantData[request.auth.uid].keys().hasOnly(['muted']))
             ||
             ('participantData' in resource.data
               && request.resource.data.participantData.diff(resource.data.participantData)
                    .affectedKeys().hasOnly([request.auth.uid])
               && request.resource.data.participantData[request.auth.uid]
                    .diff(resource.data.participantData.get(request.auth.uid, {}))
                    .affectedKeys().hasOnly(['muted']))
           ))
        );
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          // Recipient-blocked-me check: drops the write at the server so a
          // blocked sender can't bypass the client-side hide. Without this,
          // blocking is purely cosmetic on the victim's side.
          && peerHasNotBlockedMeInConv(convId)
          // mediaType is a client-supplied enum used for inbox previews and
          // viewer routing. Reject anything other than 'photo' or 'video'.
          && (!('mediaType' in request.resource.data)
            || request.resource.data.mediaType in ['photo', 'video'])
          // Block clients from presetting `_fnProcessed`. Without this check,
          // a malicious client could write `_fnProcessed: true` on create →
          // onNewMessage's pre-check sees it as already processed and skips
          // → recipient never gets unread bump or notification doc. The
          // field is Cloud-Function-only and should never appear in a
          // client-originated create.
          && !('_fnProcessed' in request.resource.data)
          && (
            // Text message
            (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000)
            ||
            // Photo / video message (text may be empty)
            (request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
              && isHttpsUrl(request.resource.data.mediaUrl))
            ||
            // Shared catch / post / spot card (text may be empty)
            (request.resource.data.sharedRef is map
              && request.resource.data.sharedRef.kind in ['catch', 'post', 'spot']
              && request.resource.data.sharedRef.id is string
              && request.resource.data.sharedRef.id.size() > 0
              && request.resource.data.sharedRef.id.size() <= 128)
          )
          // Optional replyTo metadata — validated when present.
          && (!('replyTo' in request.resource.data)
            || (request.resource.data.replyTo is map
              && request.resource.data.replyTo.messageId is string
              && request.resource.data.replyTo.messageId.size() <= 128
              && request.resource.data.replyTo.senderUid is string
              && request.resource.data.replyTo.preview is string
              && request.resource.data.replyTo.preview.size() <= 200))
          // Optional sharedRef metadata — validated when present (incl. when it's the primary content).
          && (!('sharedRef' in request.resource.data)
            || (request.resource.data.sharedRef is map
              && request.resource.data.sharedRef.kind in ['catch', 'post', 'spot']
              && request.resource.data.sharedRef.id is string
              && request.resource.data.sharedRef.id.size() <= 128
              && (!('title' in request.resource.data.sharedRef)
                || (request.resource.data.sharedRef.title is string
                  && request.resource.data.sharedRef.title.size() <= 200))
              && (!('subtitle' in request.resource.data.sharedRef)
                || (request.resource.data.sharedRef.subtitle is string
                  && request.resource.data.sharedRef.subtitle.size() <= 200))
              && (!('photoUrl' in request.resource.data.sharedRef)
                || (request.resource.data.sharedRef.photoUrl is string
                  && request.resource.data.sharedRef.photoUrl.size() <= 2000
                  && isHttpsUrl(request.resource.data.sharedRef.photoUrl)))))
          // Per-conversation per-sender rate limit: 1000ms cooldown when the previous
          // message in this conversation was sent by the same user. Stops accidental
          // floods and casual abuse without hindering normal alternating chat.
          // (Raised from 250ms — that window allowed ~4 msg/sec via batching,
          // which is a comfortable flood floor for a determined caller.)
          && (
            !('lastSenderUid' in get(/databases/$(database)/documents/conversations/$(convId)).data)
            || get(/databases/$(database)/documents/conversations/$(convId)).data.lastSenderUid != request.auth.uid
            || !('lastMessageAt' in get(/databases/$(database)/documents/conversations/$(convId)).data)
            || request.time.toMillis() - get(/databases/$(database)/documents/conversations/$(convId)).data.lastMessageAt.toMillis() > 1000
          );
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && (
            // Recipient stamps readAt for read-receipts.
            (resource.data.senderUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
              && request.resource.data.readAt == request.time)
            ||
            // Sender edits their own text within the 15-minute window.
            (resource.data.senderUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
              && request.resource.data.editedAt == request.time
              && resource.data.createdAt is timestamp
              && resource.data.createdAt.toMillis() > request.time.toMillis() - 15 * 60 * 1000)
            ||
            // Sender soft-deletes their own message within the 15-minute window.
            (resource.data.senderUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
              && request.resource.data.deletedAt == request.time
              && resource.data.createdAt is timestamp
              && resource.data.createdAt.toMillis() > request.time.toMillis() - 15 * 60 * 1000)
          );
        allow delete: if false;
      }

      /** Per-message reactions, keyed by messageId. The doc is a map of uid → emoji code.
          Any participant can react, but only on their own key. A blocked user
          can't react to the blocker's messages either — same rationale as
          message create. */
      match /reactions/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && peerHasNotBlockedMeInConv(convId)
          && request.resource.data.keys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data)
            || request.resource.data[request.auth.uid] in ['heart','fire','trophy','fish','wow']);
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && peerHasNotBlockedMeInConv(convId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data)
            || request.resource.data[request.auth.uid] in ['heart','fire','trophy','fish','wow']);
        allow delete: if false;
      }

      /** Typing indicators — both participants can read/write their own status. */
      match /typing/{uid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow write: if isSelf(uid)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
      }
    }
  }
}
